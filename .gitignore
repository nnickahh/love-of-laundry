# Edge captures (generated scan images)
edge/static/captures/*
!edge/static/captures/.gitkeep

# Launcher scripts (local convenience)
start_*.bat
start_*.ps1

# OS / Editor configurations
.vscode/
.idea/
.DS_Store
Thumbs.db
